NODE_ENV=development
PORT=4000
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_MAX_AGE_MINUTES=15

MONGO_URI=mongodb://127.0.0.1:27017/educore_lms
REDIS_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh-secret
JWT_TOKEN_HASH_SECRET=replace-with-at-least-32-characters-token-hash-secret
JWT_ISSUER=educore
JWT_AUDIENCE=educore-lms
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_TTL_DAYS=30

BCRYPT_SALT_ROUNDS=12
ACCOUNT_LOCK_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

PASSWORD_RESET_TTL_SECONDS=1800
API_PUBLIC_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_NAME=EduCore
BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=educore/avatars

MAX_AVATAR_SIZE_BYTES=5242880

# Mux Integration Settings (Optional: falls back to local chunk uploads if empty)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Razorpay Integration Settings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SEED_PLATFORM_OWNER_NAME=Root Platform Owner
SEED_PLATFORM_OWNER_EMAIL=owner@educore.com
SEED_PLATFORM_OWNER_PASSWORD=replace-with-a-strong-password
SEED_PLATFORM_OWNER_RESET_PASSWORD=false

SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@educore.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@educore.com
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMINS_RESET_PASSWORD=false

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/tutors/google/callback


